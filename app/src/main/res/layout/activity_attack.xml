<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:backgroundColor="@color/surface_dark">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:titleTextColor="@color/text_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Target info bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_elevated"
            android:padding="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@color/risk_high"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tv_card_type_label"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Left panel: operation buttons -->
            <ScrollView
                android:layout_width="180dp"
                android:layout_height="match_parent"
                android:background="@color/surface_dark">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- MIFARE Classic group -->
                    <LinearLayout
                        android:id="@+id/group_mifare"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="MIFARE CLASSIC"
                            android:textColor="@color/accent_cyan"
                            android:textSize="10sp"
                            android:letterSpacing="0.1"
                            android:paddingVertical="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_default_key_attack"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Key Attack"
                            android:textSize="11sp"
                            app:backgroundTint="@color/surface_elevated"
                            android:textColor="@color/risk_high"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_dump_card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Dump Sectors"
                            android:textSize="11sp"
                            app:backgroundTint="@color/surface_elevated"
                            android:textColor="@color/text_primary"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_write_block"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Write Block"
                            android:textSize="11sp"
                            app:backgroundTint="@color/surface_elevated"
                            android:textColor="@color/risk_medium"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_value_increment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Value ++"
                            android:textSize="11sp"
                            app:backgroundTint="@color/surface_elevated"
                            android:textColor="@color/text_primary"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_value_decrement"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="Value --"
                            android:textSize="11sp"
                            app:backgroundTint="@color/surface_elevated"
                            android:textColor="@color/text_primary"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                    </LinearLayout>

                    <!-- Ultralight group -->
                    <LinearLayout
                        android:id="@+id/group_ultralight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ULTRALIGHT"
                            android:textColor="@color/accent_cyan"
                            android:textSize="10sp"
                            android:letterSpacing="0.1"
                            android:paddingVertical="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_ul_dump"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Dump Pages"
                            android:textSize="11sp"
                            app:backgroundTint="@color/surface_elevated"
                            android:textColor="@color/text_primary"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_ul_write_page"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="Write Page"
                            android:textSize="11sp"
                            app:backgroundTint="@color/surface_elevated"
                            android:textColor="@color/risk_medium"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                    </LinearLayout>

                    <!-- NDEF group -->
                    <LinearLayout
                        android:id="@+id/group_ndef"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="NDEF"
                            android:textColor="@color/accent_cyan"
                            android:textSize="10sp"
                            android:letterSpacing="0.1"
                            android:paddingVertical="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_ndef_write_url"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Write URL"
                            android:textSize="11sp"
                            app:backgroundTint="@color/surface_elevated"
                            android:textColor="@color/text_primary"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_ndef_write_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Write Text"
                            android:textSize="11sp"
                            app:backgroundTint="@color/surface_elevated"
                            android:textColor="@color/text_primary"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_ndef_write_smart_poster"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Smart Poster"
                            android:textSize="11sp"
                            app:backgroundTint="@color/surface_elevated"
                            android:textColor="@color/text_primary"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_ndef_erase"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Erase NDEF"
                            android:textSize="11sp"
                            app:backgroundTint="@color/surface_elevated"
                            android:textColor="@color/risk_medium"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_ndef_lock"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="Lock (R/O)"
                            android:textSize="11sp"
                            app:backgroundTint="@color/surface_elevated"
                            android:textColor="@color/risk_high"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                    </LinearLayout>

                    <!-- ISO-DEP / DESFire group -->
                    <LinearLayout
                        android:id="@+id/group_iso_dep"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ISO-DEP / DESFIRE"
                            android:textColor="@color/accent_cyan"
                            android:textSize="10sp"
                            android:letterSpacing="0.1"
                            android:paddingVertical="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_desfire_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="DESFire Info"
                            android:textSize="11sp"
                            app:backgroundTint="@color/surface_elevated"
                            android:textColor="@color/text_primary"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_custom_apdu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="Custom APDU"
                            android:textSize="11sp"
                            app:backgroundTint="@color/surface_elevated"
                            android:textColor="@color/accent_purple"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

            <!-- Right panel: output log -->
            <ScrollView
                android:id="@+id/scroll_log"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/background_dark">

                <TextView
                    android:id="@+id/tv_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp" />

            </ScrollView>

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
