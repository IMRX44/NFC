<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SCAN RESULTS"
        android:textColor="@color/neon_cyan"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:layout_marginBottom="16dp"/>

    <!-- Card info section -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_info_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tv_card_type"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="--"
                    android:textColor="@color/neon_cyan"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>

                <TextView
                    android:id="@+id/tv_security_grade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/neon_green"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/card_bg"/>
            </LinearLayout>

            <!-- Info rows -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="UID" android:textColor="@color/text_secondary" android:textSize="12sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/tv_uid" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/text_primary" android:textSize="12sp" android:fontFamily="monospace"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="ATQA" android:textColor="@color/text_secondary" android:textSize="12sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/tv_atqa" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/text_primary" android:textSize="12sp" android:fontFamily="monospace"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="SAK" android:textColor="@color/text_secondary" android:textSize="12sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/tv_sak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/text_primary" android:textSize="12sp" android:fontFamily="monospace"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="Encryption" android:textColor="@color/text_secondary" android:textSize="12sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/tv_encryption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/text_primary" android:textSize="12sp" android:fontFamily="monospace"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="Size" android:textColor="@color/text_secondary" android:textSize="12sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/tv_size" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/text_primary" android:textSize="12sp" android:fontFamily="monospace"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Vulnerabilities -->
    <TextView
        android:id="@+id/tv_vulns_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VULNERABILITIES"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.2"
        android:layout_marginBottom="8dp"
        android:visibility="gone"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/ll_vulns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <!-- Action buttons -->
    <LinearLayout
        android:id="@+id/ll_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_attack_card"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="ATTACK"
            android:textColor="@color/bg_primary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:background="@drawable/btn_attack"/>

        <Button
            android:id="@+id/btn_export_report"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="EXPORT"
            android:textColor="@color/neon_cyan"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:backgroundTint="@color/bg_card"/>
    </LinearLayout>

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/ll_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_scan"
            android:alpha="0.3"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No tag scanned yet"
            android:textColor="@color/text_hint"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:layout_marginTop="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hold an NFC tag near the device"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:fontFamily="monospace"/>
    </LinearLayout>

</LinearLayout>
