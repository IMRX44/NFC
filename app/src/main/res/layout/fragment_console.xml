<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/bg_secondary">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="▶ TERMINAL"
            android:textColor="@color/neon_green"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btn_clear_console"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="CLEAR"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:backgroundTint="@color/bg_elevated"/>
    </LinearLayout>

    <!-- Terminal output -->
    <ScrollView
        android:id="@+id/scroll_terminal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg_primary"
        android:padding="12dp"
        android:fillViewport="true">

        <TextView
            android:id="@+id/tv_console_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NFC PHANTOM v2.0 // READY\n──────────────────────\n"
            android:textColor="@color/text_terminal"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.4"/>
    </ScrollView>

    <!-- Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="@color/bg_secondary">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$ "
            android:textColor="@color/neon_green"
            android:textSize="14sp"
            android:fontFamily="monospace"/>

        <EditText
            android:id="@+id/et_console_input"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:hint="type command..."
            android:textColor="@color/neon_green"
            android:textColorHint="@color/text_hint"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:background="@null"
            android:inputType="textNoSuggestions"
            android:imeOptions="actionSend"/>

        <ImageButton
            android:id="@+id/btn_send_cmd"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_terminal"
            android:background="@drawable/btn_cyber"
            android:contentDescription="Send"
            android:padding="8dp"/>
    </LinearLayout>

</LinearLayout>
